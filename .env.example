# URL configuration for canonicals and SEO — used by src/config/seo-data.ts (SITE_URL)
VITE_SITE_URL=https://pdfminty.com

# Firebase Authentication Configuration (Web App Client Keys from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Note: GEMINI_API_KEY / GORK_API_KEY will be a Cloudflare secret in production, not a Vite env var.
# For local Pages Functions testing via `wrangler pages dev`, set it in a .dev.vars file:
# GEMINI_API_KEY=your_key_here
# GORK_API_KEY=key1, key2
# GEMINI_MODEL=gemini-2.0-flash
# RESEND_API_KEY=re_your_api_key
# RESEND_AUDIENCE_ID=your_audience_id_here
# RESEND_FROM_EMAIL=onboarding@resend.dev
# NOTIFICATION_EMAIL=recipient@example.com
